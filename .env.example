# Copy to .env and adjust. Every value here is optional except DATABASE_URL.
# Never put a bank password in this file - credentials live, encrypted, in
# accounts.config.json (see docs/INSTALL.md).

# SQLite file, relative to the prisma/ folder.
DATABASE_URL="file:./myledger.db"

# How many months back the FIRST sync of a provider reaches. Later syncs only
# refresh the last 3 months. Most card sites allow up to 12-18.
SCRAPE_MONTHS_BACK=12

# "true" shows the browser while syncing - for debugging a login only.
SCRAPER_SHOW_BROWSER=false

# Dashboard port (the server only ever listens on 127.0.0.1).
# API_PORT=3010

# Optional local model for category suggestions. Must be a localhost URL -
# merchant names are never sent to a remote host.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma2:9b

# Telegram fallback for headless setups. Prefer the Settings page, which
# stores the token encrypted instead of in this plain-text file.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Demo build: refuses every route that could reach a bank or Telegram.
# MYLEDGER_DEMO=1

# Only for UI development against a server on another origin. Leave unset:
# the Vite dev server proxies /api, so no CORS is needed.
# MYLEDGER_DEV_ORIGINS=http://localhost:5173
