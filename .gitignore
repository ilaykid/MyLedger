node_modules/
dist/

# Secrets & local data - never commit
.env
.env.*
!.env.example
accounts.config.json
accounts.config.json.*
backup.config.json.*
*.log
*.log.*
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/*.db
prisma/*.db-journal

# Persistent browser profiles hold LIVE session cookies for your bank -
# as sensitive as the credentials themselves.
.browser-profiles/

# Generated by "npm run schedule:install"; the logs hold transaction details
scripts/nightly.cmd
scripts/api.cmd
scripts/api-hidden.vbs
nightly.log
api.log
api.log.1
nightly.log.1

# Cross-process scrape mutex - runtime state, never source
.scrape.lock

# Backup destination + the DPAPI-sealed passphrase that unlocks the archives
backup.config.json
*.mlbk

# Local assistant/session metadata can contain transcript fragments and paths.
.claude/
.codex/

# One-off diagnostic files and screenshots are never source.
_*.ts
screenshots/
dist-demo/

# Personal notes, reviews of real data and machine-specific one-offs.
private/
